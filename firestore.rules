rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    function userData() {
      return get(userPath()).data;
    }

    function activeUser() {
      return signedIn()
        && exists(userPath())
        && (!('activo' in userData()) || userData().activo == true);
    }

    function admin() {
      return signedIn() && (
        request.auth.token.email == 'nahuel@hui.com'
        || (activeUser() && userData().rol == 'admin')
      );
    }

    function hasPermission(permission) {
      return activeUser() && (
        admin()
        || ('permisos' in userData()
          && permission in userData().permisos
          && userData().permisos[permission] == true)
      );
    }

    function validAuditOnCreate() {
      return request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.actualizadoEn == request.time;
    }

    function validAuditOnUpdate() {
      return request.resource.data.creadoPor == resource.data.creadoPor
        && request.resource.data.creadoEn == resource.data.creadoEn
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time;
    }

    function validFinancialAccountUpdate(accountId) {
      let movement = getAfter(/databases/$(database)/documents/movimientos/$(request.resource.data.ultimaOperacionId)).data;
      let amount = movement.monto;
      return ((movement.origen == 'manual' && hasPermission('movimientosCrear'))
          || (movement.origen == 'prestadores' && hasPermission('movimientosCrear'))
          || (movement.origen == 'cobro' && hasPermission('cobrosRegistrar'))
          || (movement.origen == 'anulacion' && hasPermission('cobrosAnular')))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'saldoActual', 'ultimaOperacionId', 'actualizadoPor', 'actualizadoEn'
        ])
        && request.resource.data.saldoActual is number
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
        && movement.creadoPor == request.auth.uid
        && movement.anulado == false
        && amount is number && amount > 0
        && (
          (movement.categoria == 'ingreso' && movement.cuentaId == accountId && request.resource.data.saldoActual == resource.data.saldoActual + amount)
          || (movement.categoria in ['egreso', 'inversion'] && movement.cuentaId == accountId && request.resource.data.saldoActual == resource.data.saldoActual - amount)
          || (movement.categoria == 'transferencia' && movement.cuentaOrigenId == accountId && request.resource.data.saldoActual == resource.data.saldoActual - amount)
          || (movement.categoria == 'transferencia' && movement.cuentaDestinoId == accountId && request.resource.data.saldoActual == resource.data.saldoActual + amount)
        );
    }

    function validAccountAdjustment(accountId) {
      let movement = getAfter(/databases/$(database)/documents/movimientos/$(request.resource.data.ultimaOperacionId)).data;
      return movement.origen == 'ajuste'
        && movement.referenciaId == accountId
        && movement.cuentaId == accountId
        && movement.creadoPor == request.auth.uid
        && movement.anulado == false
        && movement.monto is number
        && movement.monto > 0
        && ((movement.categoria == 'ingreso' && request.resource.data.saldoActual == resource.data.saldoActual + movement.monto)
          || (movement.categoria == 'egreso' && request.resource.data.saldoActual == resource.data.saldoActual - movement.monto));
    }

    function validAccountAdminEdit(accountId) {
      let changedBalance = request.resource.data.saldoActual != resource.data.saldoActual;
      return hasPermission('cuentasAdministrar')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nombre', 'descripcion', 'saldoInicial', 'saldoActual', 'activa',
          'ultimaOperacionId', 'actualizadoPor', 'actualizadoEn'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.descripcion is string
        && request.resource.data.saldoInicial is number
        && request.resource.data.saldoInicial >= 0
        && request.resource.data.saldoActual is number
        && request.resource.data.saldoActual >= 0
        && request.resource.data.activa is bool
        && request.resource.data.moneda == resource.data.moneda
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
        && (!changedBalance || validAccountAdjustment(accountId));
    }

    function validCashRegisterAccountUpdate(accountId) {
      let opening = request.resource.data.cajaActivaId is string && request.resource.data.cajaActivaId.size() > 0;
      let cashRegisterId = opening ? request.resource.data.cajaActivaId : request.resource.data.ultimaCajaCerradaId;
      let cashRegister = getAfter(/databases/$(database)/documents/cajas/$(cashRegisterId)).data;
      return hasPermission('cuentasAdministrar')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cajaActivaId', 'ultimaCajaCerradaId', 'actualizadoPor', 'actualizadoEn'
        ])
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
        && cashRegister.cuentaId == accountId
        && ((opening
            && (!('cajaActivaId' in resource.data) || resource.data.cajaActivaId == '')
            && cashRegister.estado == 'Abierta')
          || (!opening
            && resource.data.cajaActivaId == request.resource.data.ultimaCajaCerradaId
            && cashRegister.estado == 'Cerrada'));
    }

    function validCobroDestination(cobroId, destination) {
      let movement = getAfter(/databases/$(database)/documents/movimientos/$(destination.movimientoId)).data;
      return destination.cuentaId is string
        && destination.movimientoId is string
        && destination.monto is number
        && destination.monto > 0
        && movement.origen == 'cobro'
        && movement.referenciaId == cobroId
        && movement.cuentaId == destination.cuentaId
        && movement.monto == destination.monto
        && getAfter(/databases/$(database)/documents/cuentas/$(destination.cuentaId)).data.ultimaOperacionId == destination.movimientoId;
    }

    function validCobroDistribution(cobroId) {
      let distribution = request.resource.data.distribucion;
      return distribution is list
        && distribution.size() >= 1
        && distribution.size() <= 5
        && (distribution.size() < 2 || (distribution[0].cuentaId != distribution[1].cuentaId && distribution[0].movimientoId != distribution[1].movimientoId))
        && (distribution.size() < 3 || ((distribution[0].cuentaId != distribution[2].cuentaId && distribution[0].movimientoId != distribution[2].movimientoId) && (distribution[1].cuentaId != distribution[2].cuentaId && distribution[1].movimientoId != distribution[2].movimientoId)))
        && (distribution.size() < 4 || ((distribution[0].cuentaId != distribution[3].cuentaId && distribution[0].movimientoId != distribution[3].movimientoId) && (distribution[1].cuentaId != distribution[3].cuentaId && distribution[1].movimientoId != distribution[3].movimientoId) && (distribution[2].cuentaId != distribution[3].cuentaId && distribution[2].movimientoId != distribution[3].movimientoId)))
        && (distribution.size() < 5 || ((distribution[0].cuentaId != distribution[4].cuentaId && distribution[0].movimientoId != distribution[4].movimientoId) && (distribution[1].cuentaId != distribution[4].cuentaId && distribution[1].movimientoId != distribution[4].movimientoId) && (distribution[2].cuentaId != distribution[4].cuentaId && distribution[2].movimientoId != distribution[4].movimientoId) && (distribution[3].cuentaId != distribution[4].cuentaId && distribution[3].movimientoId != distribution[4].movimientoId)))
        && request.resource.data.cuentaId == distribution[0].cuentaId
        && request.resource.data.movimientoId == distribution[0].movimientoId
        && validCobroDestination(cobroId, distribution[0])
        && (distribution.size() < 2 || validCobroDestination(cobroId, distribution[1]))
        && (distribution.size() < 3 || validCobroDestination(cobroId, distribution[2]))
        && (distribution.size() < 4 || validCobroDestination(cobroId, distribution[3]))
        && (distribution.size() < 5 || validCobroDestination(cobroId, distribution[4]))
        && ((distribution.size() == 1 && request.resource.data.monto == distribution[0].monto)
          || (distribution.size() == 2 && request.resource.data.monto == distribution[0].monto + distribution[1].monto)
          || (distribution.size() == 3 && request.resource.data.monto == distribution[0].monto + distribution[1].monto + distribution[2].monto)
          || (distribution.size() == 4 && request.resource.data.monto == distribution[0].monto + distribution[1].monto + distribution[2].monto + distribution[3].monto)
          || (distribution.size() == 5 && request.resource.data.monto == distribution[0].monto + distribution[1].monto + distribution[2].monto + distribution[3].monto + distribution[4].monto));
    }

    function validCobroApplication(application) {
      let configured = application.tipoCobroId is string && application.tipoCobroId.size() > 0;
      let rawDiscount = application.montoAplicado * application.porcentajeDescuento / 100;
      return application.cuentaId is string
        && application.tipoCobroId is string
        && application.tipoCobroNombre is string
        && application.montoAplicado is number
        && application.montoAplicado > 0
        && application.monto is number
        && application.monto > 0
        && application.descuento is number
        && application.descuento >= 0
        && application.montoAplicado == application.monto + application.descuento
        && application.porcentajeDescuento is number
        && application.porcentajeDescuento >= 0
        && application.porcentajeDescuento <= 100
        && ((!configured
            && application.porcentajeDescuento == 0
            && application.descuento == 0)
          || (configured
            && get(/databases/$(database)/documents/tiposCobro/$(application.tipoCobroId)).data.activo == true
            && get(/databases/$(database)/documents/tiposCobro/$(application.tipoCobroId)).data.cuentaId == application.cuentaId
            && get(/databases/$(database)/documents/tiposCobro/$(application.tipoCobroId)).data.nombre == application.tipoCobroNombre
            && get(/databases/$(database)/documents/tiposCobro/$(application.tipoCobroId)).data.porcentajeDescuento == application.porcentajeDescuento
            && application.descuento >= rawDiscount - 0.5
            && application.descuento < rawDiscount + 0.5));
    }

    function validCobroApplications() {
      let applications = request.resource.data.aplicacionesCobro;
      let isBeverage = request.resource.data.ventaBebidasId != null;
      return applications is list
        && ((isBeverage && applications.size() == 0 && request.resource.data.descuento == 0)
          || (!isBeverage
            && applications.size() >= 1
            && applications.size() <= 2
            && validCobroApplication(applications[0])
            && (applications.size() < 2 || validCobroApplication(applications[1]))
            && applications[0].cuentaId == request.resource.data.distribucion[0].cuentaId
            && applications[0].monto == request.resource.data.distribucion[0].monto
            && (applications.size() < 2 || (
              applications[1].cuentaId == request.resource.data.distribucion[1].cuentaId
              && applications[1].monto == request.resource.data.distribucion[1].monto
            ))
            && ((applications.size() == 1
                && request.resource.data.montoAplicado == applications[0].montoAplicado
                && request.resource.data.descuento == applications[0].descuento
                && request.resource.data.monto == applications[0].monto)
              || (applications.size() == 2
                && request.resource.data.montoAplicado == applications[0].montoAplicado + applications[1].montoAplicado
                && request.resource.data.descuento == applications[0].descuento + applications[1].descuento
                && request.resource.data.monto == applications[0].monto + applications[1].monto))));
    }

    function syncedCustomerData(clienteId) {
      let customer = getAfter(/databases/$(database)/documents/clientes/$(clienteId)).data;
      let customerName = customer.esEmpresa == true ? customer.nombre : customer.nombre + ' ' + customer.apellido;
      return request.resource.data.cliente == customerName
        && request.resource.data.telefono == customer.telefono;
    }

    match /usuarios/{uid} {
      allow get: if (signedIn() && request.auth.uid == uid) || admin();
      allow list, create, update, delete: if admin();
    }

    match /eventos/{eventoId} {
      allow read: if hasPermission('eventosVer');
      allow create: if hasPermission('eventosCrear');
      allow update: if (hasPermission('eventosEditar')
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'sena', 'totalCobrado', 'saldo', 'total', 'ultimoCobroId', 'ultimaAnulacionCobroId',
          'totalDescuentosCobros', 'ventasBebidas', 'ultimaVentaBebidasId', 'cliente', 'telefono'
        ])
        && (!(request.resource.data.estado in ['Cancelado', 'cancelado'])
          || request.resource.data.estado == resource.data.estado
          || hasPermission('eventosCancelar'))) || (
        hasPermission('cobrosRegistrar')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'sena', 'totalCobrado', 'totalDescuentosCobros', 'saldo', 'estado', 'ultimoCobroId', 'ventasBebidas', 'actualizadoPor', 'actualizadoEn'
        ])
        && getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.ultimoCobroId)).data.eventoId == eventoId
        && request.resource.data.saldo == resource.data.saldo - getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.ultimoCobroId)).data.montoAplicado
        && request.resource.data.sena == request.resource.data.totalCobrado
        && request.resource.data.totalCobrado is number
        && request.resource.data.totalCobrado >= getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.ultimoCobroId)).data.monto
        && request.resource.data.totalDescuentosCobros == resource.data.get('totalDescuentosCobros', 0) + getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.ultimoCobroId)).data.descuento
        && request.resource.data.saldo >= 0
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
      ) || (
        admin() && hasPermission('cobrosAnular')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'sena', 'totalCobrado', 'totalDescuentosCobros', 'saldo', 'estado', 'ultimaAnulacionCobroId', 'ventasBebidas', 'actualizadoPor', 'actualizadoEn'
        ])
        && getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.ultimaAnulacionCobroId)).data.eventoId == eventoId
        && getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.ultimaAnulacionCobroId)).data.anulado == true
        && request.resource.data.totalCobrado == resource.data.totalCobrado - getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.ultimaAnulacionCobroId)).data.monto
        && request.resource.data.sena == request.resource.data.totalCobrado
        && request.resource.data.totalDescuentosCobros == resource.data.get('totalDescuentosCobros', 0) - getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.ultimaAnulacionCobroId)).data.get('descuento', 0)
        && request.resource.data.saldo == resource.data.saldo + getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.ultimaAnulacionCobroId)).data.get('montoAplicado', getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.ultimaAnulacionCobroId)).data.monto)
        && request.resource.data.totalCobrado >= 0
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
      ) || (
        (hasPermission('eventosCrear') || hasPermission('configuracionAdministrar'))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'cliente', 'telefono', 'actualizadoPor', 'actualizadoEn'
        ])
        && request.resource.data.clienteId == resource.data.clienteId
        && syncedCustomerData(request.resource.data.clienteId)
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
      ) || (
        hasPermission('eventosEditar')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ventasBebidas', 'total', 'saldo', 'ultimaVentaBebidasId', 'actualizadoPor', 'actualizadoEn'
        ])
        && request.resource.data.ventasBebidas is list
        && ((!('ventasBebidas' in resource.data) && request.resource.data.ventasBebidas.size() == 1)
          || ('ventasBebidas' in resource.data && request.resource.data.ventasBebidas.size() == resource.data.ventasBebidas.size() + 1))
        && (!('ventasBebidas' in resource.data) || request.resource.data.ventasBebidas.hasAll(resource.data.ventasBebidas))
        && request.resource.data.total > resource.data.total
        && request.resource.data.saldo == resource.data.saldo + (request.resource.data.total - resource.data.total)
        && request.resource.data.ventasBebidas[request.resource.data.ventasBebidas.size() - 1].id == request.resource.data.ultimaVentaBebidasId
        && request.resource.data.ventasBebidas[request.resource.data.ventasBebidas.size() - 1].total == request.resource.data.total - resource.data.total
        && request.resource.data.ventasBebidas[request.resource.data.ventasBebidas.size() - 1].cobrado == 0
        && request.resource.data.ventasBebidas[request.resource.data.ventasBebidas.size() - 1].saldo == request.resource.data.ventasBebidas[request.resource.data.ventasBebidas.size() - 1].total
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
      ) || (
        hasPermission('eventosEditar')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ventasBebidas', 'total', 'saldo', 'ultimaVentaBebidasAnterior', 'ultimaVentaBebidasEditada', 'actualizadoPor', 'actualizadoEn'
        ])
        && resource.data.ventasBebidas is list
        && request.resource.data.ventasBebidas is list
        && request.resource.data.ventasBebidas.size() == resource.data.ventasBebidas.size()
        && resource.data.ventasBebidas.hasAny([request.resource.data.ultimaVentaBebidasAnterior])
        && request.resource.data.ventasBebidas.hasAny([request.resource.data.ultimaVentaBebidasEditada])
        && request.resource.data.ultimaVentaBebidasAnterior.id == request.resource.data.ultimaVentaBebidasEditada.id
        && request.resource.data.ultimaVentaBebidasAnterior.cobrado == 0
        && request.resource.data.ultimaVentaBebidasAnterior.saldo == request.resource.data.ultimaVentaBebidasAnterior.total
        && request.resource.data.ultimaVentaBebidasEditada.cobrado == 0
        && request.resource.data.ultimaVentaBebidasEditada.saldo == request.resource.data.ultimaVentaBebidasEditada.total
        && request.resource.data.total == resource.data.total - request.resource.data.ultimaVentaBebidasAnterior.total + request.resource.data.ultimaVentaBebidasEditada.total
        && request.resource.data.saldo == resource.data.saldo - request.resource.data.ultimaVentaBebidasAnterior.total + request.resource.data.ultimaVentaBebidasEditada.total
        && request.resource.data.total >= request.resource.data.totalCobrado
        && request.resource.data.saldo >= 0
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
      ) || (
        hasPermission('eventosEditar')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ventasBebidas', 'total', 'saldo', 'ultimaVentaBebidasEliminada', 'actualizadoPor', 'actualizadoEn'
        ])
        && resource.data.ventasBebidas is list
        && request.resource.data.ventasBebidas is list
        && request.resource.data.ventasBebidas.size() == resource.data.ventasBebidas.size() - 1
        && resource.data.ventasBebidas.hasAll(request.resource.data.ventasBebidas)
        && resource.data.ventasBebidas.hasAny([request.resource.data.ultimaVentaBebidasEliminada])
        && request.resource.data.ultimaVentaBebidasEliminada.cobrado == 0
        && request.resource.data.ultimaVentaBebidasEliminada.saldo == request.resource.data.ultimaVentaBebidasEliminada.total
        && request.resource.data.total == resource.data.total - request.resource.data.ultimaVentaBebidasEliminada.total
        && request.resource.data.saldo == resource.data.saldo - request.resource.data.ultimaVentaBebidasEliminada.total
        && request.resource.data.total >= request.resource.data.totalCobrado
        && request.resource.data.saldo >= 0
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
      );
      allow delete: if admin();
    }

    match /clientes/{clienteId} {
      allow read: if hasPermission('eventosVer') || hasPermission('eventosCrear') || hasPermission('configuracionAdministrar');
      allow create: if (hasPermission('eventosCrear') || hasPermission('configuracionAdministrar'))
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() > 0
        && request.resource.data.activo == true
        && validAuditOnCreate();
      allow update: if (hasPermission('eventosCrear') || hasPermission('configuracionAdministrar'))
        && request.resource.data.telefono is string
        && request.resource.data.telefono.size() > 0
        && validAuditOnUpdate();
      allow delete: if false;
    }

    match /escuelas/{escuelaId} {
      allow read: if hasPermission('eventosVer') || hasPermission('eventosCrear') || hasPermission('configuracionAdministrar');
      allow create: if hasPermission('configuracionAdministrar')
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.activa == true
        && validAuditOnCreate();
      allow update: if hasPermission('configuracionAdministrar')
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && validAuditOnUpdate();
      allow delete: if admin();
    }

    match /listasPrecios/{listaId} {
      allow read: if hasPermission('eventosVer') || hasPermission('eventosCrear') || hasPermission('configuracionAdministrar');
      allow create: if hasPermission('configuracionAdministrar')
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.moneda == 'ARS'
        && request.resource.data.servicios is list
        && request.resource.data.bebidas is list
        && validAuditOnCreate();
      allow update: if hasPermission('configuracionAdministrar') && validAuditOnUpdate();
      allow delete: if false;
    }

    match /cuentas/{cuentaId} {
      allow read: if hasPermission('cuentasVer');

      allow create: if hasPermission('cuentasCrear')
        && request.resource.data.keys().hasOnly([
          'nombre', 'descripcion', 'moneda', 'saldoInicial', 'saldoActual',
          'activa', 'creadoPor', 'actualizadoPor', 'creadoEn', 'actualizadoEn'
        ])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.descripcion is string
        && request.resource.data.moneda == 'ARS'
        && request.resource.data.saldoInicial is number
        && request.resource.data.saldoInicial >= 0
        && request.resource.data.saldoActual == request.resource.data.saldoInicial
        && request.resource.data.activa == true
        && validAuditOnCreate();

      // El nombre y el estado pueden editarse sin alterar los saldos.
      allow update: if (
        hasPermission('cuentasAdministrar')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'activa', 'actualizadoPor', 'actualizadoEn'])
          && request.resource.data.nombre is string
          && request.resource.data.nombre.size() > 0
          && request.resource.data.activa is bool
          && validAuditOnUpdate()
        ) || validCashRegisterAccountUpdate(cuentaId) || validAccountAdminEdit(cuentaId) || validFinancialAccountUpdate(cuentaId);

      allow delete: if false;
    }

    match /cajas/{cajaId} {
      allow read: if hasPermission('cuentasVer');
      allow create: if hasPermission('cuentasAdministrar')
        && request.resource.data.cuentaId is string
        && request.resource.data.cuentaNombre is string
        && request.resource.data.fechaApertura is timestamp
        && request.resource.data.montoApertura is number
        && request.resource.data.montoApertura >= 0
        && request.resource.data.estado == 'Abierta'
        && request.resource.data.abiertoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.actualizadoEn == request.time
        && getAfter(/databases/$(database)/documents/cuentas/$(request.resource.data.cuentaId)).data.cajaActivaId == cajaId;
      allow update: if hasPermission('cuentasAdministrar')
        && resource.data.estado == 'Abierta'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fechaCierre', 'montoCierre', 'resultado', 'movimientoIds', 'estado',
          'cerradoPor', 'cerradoPorNombre', 'actualizadoEn'
        ])
        && request.resource.data.fechaCierre is timestamp
        && request.resource.data.fechaCierre > resource.data.fechaApertura
        && request.resource.data.montoCierre is number
        && request.resource.data.resultado == request.resource.data.montoCierre - resource.data.montoApertura
        && request.resource.data.movimientoIds is list
        && request.resource.data.estado == 'Cerrada'
        && request.resource.data.cerradoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time
        && getAfter(/databases/$(database)/documents/cuentas/$(resource.data.cuentaId)).data.cajaActivaId == ''
        && getAfter(/databases/$(database)/documents/cuentas/$(resource.data.cuentaId)).data.ultimaCajaCerradaId == cajaId;
      allow delete: if false;
    }

    // Estas escrituras se habilitaran junto con las operaciones transaccionales.
    match /cobros/{cobroId} {
      allow read: if hasPermission('eventosVer') || hasPermission('cobrosRegistrar') || hasPermission('cobrosAnular');
      allow create: if hasPermission('cobrosRegistrar')
        && request.resource.data.eventoId is string
        && request.resource.data.cuentaId is string
        && request.resource.data.movimientoId is string
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.montoAplicado is number
        && request.resource.data.montoAplicado >= request.resource.data.monto
        && request.resource.data.descuento is number
        && request.resource.data.descuento >= 0
        && request.resource.data.montoAplicado == request.resource.data.monto + request.resource.data.descuento
        && request.resource.data.porcentajeDescuento is number
        && request.resource.data.porcentajeDescuento >= 0
        && request.resource.data.porcentajeDescuento <= 100
        && request.resource.data.tipoCobroId is string
        && request.resource.data.tipoCobroNombre is string
        && validCobroApplications()
        && request.resource.data.moneda == 'ARS'
        && request.resource.data.fecha is timestamp
        && request.resource.data.anulado == false
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && validCobroDistribution(cobroId)
        && getAfter(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId)).data.ultimoCobroId == cobroId
        && getAfter(/databases/$(database)/documents/movimientos/$(request.resource.data.movimientoId)).data.referenciaId == cobroId;
      allow update: if admin() && hasPermission('cobrosAnular')
        && resource.data.anulado == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'anulado', 'motivoAnulacion', 'anuladoPor', 'anuladoPorNombre', 'anuladoPorEmail', 'anuladoEn', 'movimientoAnulacionId', 'movimientoAnulacionIds'
        ])
        && request.resource.data.anulado == true
        && request.resource.data.motivoAnulacion is string
        && request.resource.data.motivoAnulacion.size() > 0
        && request.resource.data.anuladoPor == request.auth.uid
        && request.resource.data.anuladoEn == request.time
        && getAfter(/databases/$(database)/documents/movimientos/$(request.resource.data.movimientoAnulacionId)).data.origen == 'anulacion'
        && getAfter(/databases/$(database)/documents/movimientos/$(request.resource.data.movimientoAnulacionId)).data.referenciaId == cobroId;
      allow delete: if false;
    }

    match /movimientos/{movimientoId} {
      allow read: if hasPermission('movimientosVer');
      allow create: if ((request.resource.data.origen == 'manual' && hasPermission('movimientosCrear'))
          || (request.resource.data.origen == 'prestadores' && hasPermission('movimientosCrear'))
          || (request.resource.data.origen == 'cobro' && hasPermission('cobrosRegistrar'))
          || (request.resource.data.origen == 'anulacion' && admin() && hasPermission('cobrosAnular'))
          || (request.resource.data.origen == 'ajuste' && hasPermission('cuentasAdministrar')))
        && request.resource.data.keys().hasAll([
          'categoria', 'tipoMovimientoNombre', 'monto', 'moneda', 'fecha',
          'origen', 'anulado', 'creadoPor', 'creadoEn'
        ])
        && request.resource.data.categoria in ['ingreso', 'egreso', 'inversion', 'transferencia']
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.moneda == 'ARS'
        && request.resource.data.fecha is timestamp
        && request.resource.data.origen in ['manual', 'prestadores', 'cobro', 'anulacion', 'ajuste']
        && request.resource.data.anulado == false
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && (
          (request.resource.data.categoria in ['ingreso', 'egreso', 'inversion']
            && getAfter(/databases/$(database)/documents/cuentas/$(request.resource.data.cuentaId)).data.ultimaOperacionId == movimientoId)
          || (request.resource.data.categoria == 'transferencia'
            && request.resource.data.cuentaOrigenId != request.resource.data.cuentaDestinoId
            && getAfter(/databases/$(database)/documents/cuentas/$(request.resource.data.cuentaOrigenId)).data.ultimaOperacionId == movimientoId
            && getAfter(/databases/$(database)/documents/cuentas/$(request.resource.data.cuentaDestinoId)).data.ultimaOperacionId == movimientoId)
        )
        && (request.resource.data.origen != 'anulacion' || (
          request.resource.data.categoria == 'egreso'
          && getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.referenciaId)).data.anulado == true
          && (request.resource.data.movimientoOriginalId == getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.referenciaId)).data.movimientoId
            || ('movimientoIds' in getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.referenciaId)).data
              && request.resource.data.movimientoOriginalId in getAfter(/databases/$(database)/documents/cobros/$(request.resource.data.referenciaId)).data.movimientoIds))
        ))
        && (request.resource.data.origen != 'ajuste' || (
          request.resource.data.categoria in ['ingreso', 'egreso']
          && request.resource.data.referenciaId == request.resource.data.cuentaId
        ));
      allow update: if (admin() && hasPermission('cobrosAnular')
        && resource.data.origen == 'cobro'
        && resource.data.anulado == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'anulado', 'anuladoPor', 'anuladoEn', 'movimientoAnulacionId'
        ])
        && request.resource.data.anulado == true
        && request.resource.data.anuladoPor == request.auth.uid
        && request.resource.data.anuladoEn == request.time
        && getAfter(/databases/$(database)/documents/movimientos/$(request.resource.data.movimientoAnulacionId)).data.movimientoOriginalId == movimientoId)
        || (admin()
          && resource.data.origen == 'manual'
          && resource.data.categoria == 'egreso'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['eventoId', 'eventoNombre', 'tipoEventoNombre', 'vinculadoPor', 'vinculadoEn'])
          && request.resource.data.eventoId is string
          && request.resource.data.eventoId.size() > 0
          && exists(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId))
          && request.resource.data.vinculadoPor == request.auth.uid
          && request.resource.data.vinculadoEn == request.time);
      allow delete: if false;
    }

    match /tiposEventos/{documentId} {
      allow read: if hasPermission('eventosVer') || hasPermission('eventosCrear') || hasPermission('eventosEditar') || hasPermission('configuracionAdministrar');
      allow create: if hasPermission('configuracionAdministrar') && validAuditOnCreate();
      allow update: if hasPermission('configuracionAdministrar') && validAuditOnUpdate();
      allow delete: if admin();
    }

    match /tiposCobro/{documentId} {
      allow read: if hasPermission('cobrosRegistrar') || hasPermission('eventosVer') || hasPermission('configuracionAdministrar');
      allow create: if hasPermission('configuracionAdministrar')
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.porcentajeDescuento is number
        && request.resource.data.porcentajeDescuento >= 0
        && request.resource.data.porcentajeDescuento <= 100
        && request.resource.data.cuentaId is string
        && request.resource.data.cuentaId.size() > 0
        && request.resource.data.cuentaNombre is string
        && request.resource.data.cuentaNombre.size() > 0
        && exists(/databases/$(database)/documents/cuentas/$(request.resource.data.cuentaId))
        && request.resource.data.activo == true
        && validAuditOnCreate();
      allow update: if hasPermission('configuracionAdministrar')
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.porcentajeDescuento is number
        && request.resource.data.porcentajeDescuento >= 0
        && request.resource.data.porcentajeDescuento <= 100
        && request.resource.data.cuentaId is string
        && request.resource.data.cuentaId.size() > 0
        && request.resource.data.cuentaNombre is string
        && request.resource.data.cuentaNombre.size() > 0
        && exists(/databases/$(database)/documents/cuentas/$(request.resource.data.cuentaId))
        && request.resource.data.activo is bool
        && validAuditOnUpdate();
      allow delete: if admin();
    }

    match /prestadores/{documentId} {
      allow read: if hasPermission('eventosVer') || hasPermission('eventosCrear') || hasPermission('eventosEditar') || hasPermission('configuracionAdministrar');
      allow create: if hasPermission('configuracionAdministrar') && validAuditOnCreate();
      allow update: if hasPermission('configuracionAdministrar') && validAuditOnUpdate();
      allow delete: if admin();
    }

    match /pagosPrestadores/{pagoId} {
      allow read: if hasPermission('movimientosVer') || hasPermission('movimientosCrear');
      allow create: if hasPermission('movimientosCrear')
        && request.resource.data.keys().hasAll([
          'eventoId', 'prestadorId', 'prestadorNombre', 'monto', 'moneda',
          'cuentaId', 'movimientoId', 'fechaPago', 'creadoPor', 'creadoEn', 'anulado'
        ])
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.moneda == 'ARS'
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.anulado == false
        && getAfter(/databases/$(database)/documents/movimientos/$(request.resource.data.movimientoId)).data.origen == 'prestadores'
        && getAfter(/databases/$(database)/documents/movimientos/$(request.resource.data.movimientoId)).data.cuentaId == request.resource.data.cuentaId;
      allow update, delete: if false;
    }

    match /stockBebidas/{stockId} {
      allow read: if hasPermission('eventosVer') || hasPermission('eventosEditar') || hasPermission('movimientosVer');
      allow create, update: if hasPermission('movimientosCrear')
        && request.resource.data.nombre is string
        && request.resource.data.cantidad is number
        && request.resource.data.cantidad >= 0
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if false;
    }

    match /movimientosStock/{movimientoId} {
      allow read: if hasPermission('movimientosVer') || hasPermission('movimientosCrear');
      allow create: if hasPermission('movimientosCrear')
        && request.resource.data.stockId is string
        && request.resource.data.cantidad is number
        && request.resource.data.cantidadNueva is number
        && request.resource.data.cantidadNueva >= 0
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time;
      allow update, delete: if false;
    }

    match /tiposMovimientos/{documentId} {
      allow read: if hasPermission('movimientosVer') || hasPermission('movimientosCrear') || hasPermission('configuracionAdministrar');
      allow create: if hasPermission('configuracionAdministrar') && validAuditOnCreate();
      allow update: if hasPermission('configuracionAdministrar') && validAuditOnUpdate();
      allow delete: if admin();
    }

    match /configuraciones/{documentId} {
      allow read, create, update: if hasPermission('configuracionAdministrar');
      allow delete: if admin();
    }

    match /comprobantesPublicos/{documentId} {
      allow get: if true;
      allow list: if hasPermission('eventosCrear') || hasPermission('configuracionAdministrar');
      allow create: if hasPermission('eventosVer')
        && request.resource.data.keys().hasOnly([
          'cobroId', 'numero', 'eventoId', 'eventoNombre', 'clienteNombre', 'clienteTelefono',
          'fechaComprobante', 'fechaEvento', 'fechaFinEvento', 'horaInicio', 'horaFin',
          'concepto', 'descripcion', 'monto', 'moneda', 'cuentaNombre', 'detalleBebidas',
          'montoAplicado', 'descuento', 'porcentajeDescuento', 'tipoCobroNombre',
          'distribucion', 'registradoPor', 'emitidoPor',
          'anulado', 'creadoPor', 'creadoEn'
        ])
        && request.resource.data.cobroId == documentId
        && request.resource.data.numero is string
        && request.resource.data.numero.matches('[0-9]{4}-[0-9]{6}')
        && request.resource.data.creadoPor == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.monto is number
        && request.resource.data.monto > 0
        && request.resource.data.moneda == 'ARS'
        && get(/databases/$(database)/documents/cobros/$(documentId)).data.eventoId == request.resource.data.eventoId;
      allow update: if (admin()
          && resource.data.anulado == false
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['anulado', 'anuladoEn'])
          && request.resource.data.anulado == true
          && request.resource.data.anuladoEn == request.time)
        || (hasPermission('eventosVer')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['numero', 'clienteNombre', 'clienteTelefono', 'detalleBebidas', 'distribucion', 'registradoPor', 'monto', 'montoAplicado', 'descuento', 'porcentajeDescuento', 'tipoCobroNombre', 'actualizadoEn'])
          && request.resource.data.numero is string
          && request.resource.data.numero.matches('[0-9]{4}-[0-9]{6}')
          && (!('clienteNombre' in request.resource.data) || request.resource.data.clienteNombre is string)
          && (!('clienteTelefono' in request.resource.data) || request.resource.data.clienteTelefono is string)
          && request.resource.data.actualizadoEn == request.time);
      allow delete: if false;
    }

    match /contadores/{contadorId} {
      allow read: if hasPermission('eventosVer');
      allow create: if hasPermission('eventosVer')
        && contadorId.matches('comprobantes-[0-9]{4}')
        && request.resource.data.ultimo == 1
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time;
      allow update: if hasPermission('eventosVer')
        && contadorId.matches('comprobantes-[0-9]{4}')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimo', 'anio', 'actualizadoPor', 'actualizadoEn'])
        && request.resource.data.ultimo == resource.data.ultimo + 1
        && request.resource.data.actualizadoPor == request.auth.uid
        && request.resource.data.actualizadoEn == request.time;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
